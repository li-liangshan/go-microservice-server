# Copy to .env for local Docker Compose overrides. Never commit .env.
#
# HTTP_AUTH_TOKEN is required: the compose stack refuses to start the API
# without it. Replace the placeholder with a random value, e.g.
#   openssl rand -hex 32
HTTP_AUTH_TOKEN=change-me-local-development-token

# Credentials of the local MySQL instance. Development defaults only.
MYSQL_ROOT_PASSWORD=root-dev-password
MYSQL_PASSWORD=microservice-dev-password

TELEMETRY_ENVIRONMENT=development
